# Keep this port local. Publish through a TLS/authenticated reverse proxy or SSH tunnel.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8501
MAX_UPLOAD_MB=100
MAX_BATCH_MB=256
MAX_BATCH_FILES=32
MAX_IMAGE_PIXELS=24000000
MAX_STORED_MB=10240
MIN_FREE_MB=2048
CPU_LIMIT=2.0
MEMORY_LIMIT=6g
# Generate locally: python -c "import secrets; print(secrets.token_hex(32))"
# Empty means Streamlit generates its own secret; set a stable value for restarts/replicas.
STREAMLIT_SERVER_COOKIE_SECRET=
# For HTTPS deployment, replace with your actual public domain and origin.
STREAMLIT_SERVER_ALLOWED_HOSTS=["localhost","127.0.0.1"]
STREAMLIT_SERVER_CORS_ALLOWED_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
