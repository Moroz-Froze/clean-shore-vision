# Include in nginx's http context. Replace shore.example.com and certificate paths.
# The app must be bound ONLY to 127.0.0.1:8501 on the same host.
map $http_upgrade $shore_connection { default upgrade; '' close; }
limit_req_zone $binary_remote_addr zone=shore_requests:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=shore_connections:10m;
server {
    listen 80;
    server_name shore.example.com;
    return 301 https://shore.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name shore.example.com;
    ssl_certificate /etc/letsencrypt/live/shore.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shore.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 105m;
    client_body_timeout 30s;
    # Create a bcrypt password file outside the repository, chmod 640.
    auth_basic "Clean Shore";
    auth_basic_user_file /etc/nginx/shore.htpasswd;
    limit_req zone=shore_requests burst=40 nodelay;
    limit_req_status 429;
    limit_conn shore_connections 20;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header Cache-Control "no-store" always;
    # Roll out CSP in reporting mode first: Streamlit/custom components need scripts/iframes.
    add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' wss://shore.example.com; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'" always;
    location / {
        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $shore_connection;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 3600s;
        proxy_buffering off;
        # XSRF cookie must remain readable by Streamlit JS; do not force HttpOnly on it.
        proxy_cookie_flags ~ secure samesite=lax;
    }
}
